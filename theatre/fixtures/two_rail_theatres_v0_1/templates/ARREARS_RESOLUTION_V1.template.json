  "template_id": "arrears_resolution_v1",
  "display_name": "ARREARS_RESOLUTION_V1 — Tenant Arrears State Machine & Ladder Redirection",
  "description": "v0.1 deterministic replay theatre for tenant arrears resolution. Validates state transitions, ladder contribution redirection to arrears, reserve fund drawdown logic, distribution adjustment during shortfall, and ladder balance protection. Covers full lifecycle: grace period, partial payment, arrears escalation, dispute handling, payment plans, recovery, and lease termination.",
  "criteria": {
    "criteria_ids": [
      "state_transition_validity",
      "ladder_redirection_arithmetic",
      "reserve_fund_impact",
      "distribution_adjustment",
      "grace_period_enforcement",
      "ladder_balance_protection"
    ],
    "criteria_human": "Deterministic verification that arrears state transitions follow committed policy, ladder contributions are correctly redirected to arrears before equity purchase, reserve fund drawdowns are arithmetically correct, investor distributions are adjusted per the loss waterfall, grace periods are enforced within timing rules, and existing ladder balances are protected from forced liquidation.",
    "weights": {
      "state_transition_validity": 0.25,
      "ladder_redirection_arithmetic": 0.25,
      "reserve_fund_impact": 0.15,
      "distribution_adjustment": 0.15,
      "grace_period_enforcement": 0.10,
      "ladder_balance_protection": 0.10
    }
  },
  "version_pins": {
    "constructs": {
      "two_rail_marketplace_core": "v0.1-fixtures"
    },
    "scorer_version": "deterministic-v0.1"
  },
  "dataset_hashes": {
    "arrears_fixtures_10.json": "a4e1915b0e9a912fa2ebd13776fa03ac7a9b2c62a07fc6ae3c61f7204d05ef9d"
  },
  "product_theatre_config": {
    "construct_under_test": {
      "construct_id": "two_rail_marketplace_core",
      "construct_version": "v0.1-fixtures"
    },
    "adapter_type": "local",
    "adapter_endpoint": "python:two_rail_oracles.deterministic",
    "replay_data_path": "/mnt/data/two_rail_theatres_v0_1/arrears_fixtures_10.json",
    "ground_truth_source": "v0.1 fixtures (deterministic arrears policy replay)",
    "mock_only": false
  },
  "fork_definitions": [],
  "resolution_programme": [
    {
      "step": "ingest",
      "action": "load_dataset",
