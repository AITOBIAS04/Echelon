  "arrears_policy": {
    "state_machine": {
      "states": [
        "CURRENT",
        "GRACE_PERIOD",
        "LATE",
        "PARTIAL_RECEIVED",
        "ARREARS",
        "LADDER_REDIRECTED",
        "DISPUTE_RAISED",
        "PAYMENT_PLAN",
        "RECOVERY",
        "EVICTION_PROCESS",
        "LEASE_TERMINATED",
        "RESOLVED"
      ],
      "initial_state": "CURRENT",
      "terminal_states": ["CURRENT", "RESOLVED", "LEASE_TERMINATED"],
      "transitions": [
        { "from": "CURRENT",           "to": "GRACE_PERIOD",     "trigger": "payment_due_date_passed",     "condition": "no_payment_received" },
        { "from": "GRACE_PERIOD",      "to": "CURRENT",          "trigger": "full_payment_received",       "condition": "amount >= rent_due" },
        { "from": "GRACE_PERIOD",      "to": "LATE",             "trigger": "grace_period_expired",        "condition": "grace_days_exceeded" },
        { "from": "GRACE_PERIOD",      "to": "PARTIAL_RECEIVED", "trigger": "partial_payment_received",    "condition": "0 < amount < rent_due" },
        { "from": "LATE",              "to": "CURRENT",          "trigger": "full_payment_received",       "condition": "amount >= total_outstanding" },
        { "from": "LATE",              "to": "PARTIAL_RECEIVED", "trigger": "partial_payment_received",    "condition": "0 < amount < total_outstanding" },
        { "from": "LATE",              "to": "ARREARS",          "trigger": "arrears_threshold_crossed",   "condition": "outstanding >= arrears_threshold" },
        { "from": "PARTIAL_RECEIVED",  "to": "CURRENT",          "trigger": "balance_cleared",             "condition": "remaining_balance == 0" },
        { "from": "PARTIAL_RECEIVED",  "to": "ARREARS",          "trigger": "arrears_threshold_crossed",   "condition": "outstanding >= arrears_threshold" },
        { "from": "ARREARS",           "to": "LADDER_REDIRECTED","trigger": "ladder_contribution_due",     "condition": "ladder_plan_active" },
        { "from": "ARREARS",           "to": "DISPUTE_RAISED",   "trigger": "tenant_dispute_filed",        "condition": "dispute_type_valid" },
        { "from": "ARREARS",           "to": "PAYMENT_PLAN",     "trigger": "payment_plan_agreed",         "condition": "plan_signed_by_both_parties" },
        { "from": "ARREARS",           "to": "RECOVERY",         "trigger": "recovery_initiated",          "condition": "arrears_age >= recovery_threshold_days" },
        { "from": "ARREARS",           "to": "CURRENT",          "trigger": "full_payment_received",       "condition": "amount >= total_outstanding" },
        { "from": "LADDER_REDIRECTED", "to": "ARREARS",          "trigger": "redirection_applied",         "condition": "outstanding > 0 after redirection" },
        { "from": "LADDER_REDIRECTED", "to": "CURRENT",          "trigger": "redirection_clears_balance",  "condition": "outstanding == 0 after redirection" },
        { "from": "DISPUTE_RAISED",    "to": "ARREARS",          "trigger": "dispute_resolved_against_tenant", "condition": "adjudication_complete" },
        { "from": "DISPUTE_RAISED",    "to": "RESOLVED",         "trigger": "dispute_resolved_for_tenant", "condition": "arrears_written_off_or_adjusted" },
        { "from": "PAYMENT_PLAN",      "to": "CURRENT",          "trigger": "plan_completed",              "condition": "all_instalments_paid" },
        { "from": "PAYMENT_PLAN",      "to": "RECOVERY",         "trigger": "plan_breached",               "condition": "missed_instalments >= breach_threshold" },
        { "from": "RECOVERY",          "to": "EVICTION_PROCESS", "trigger": "legal_notice_served",         "condition": "notice_period_requirements_met" },
        { "from": "RECOVERY",          "to": "CURRENT",          "trigger": "full_payment_received",       "condition": "amount >= total_outstanding" },
        { "from": "EVICTION_PROCESS",  "to": "LEASE_TERMINATED", "trigger": "possession_order_executed",   "condition": "court_order_granted" },
        { "from": "EVICTION_PROCESS",  "to": "CURRENT",          "trigger": "full_payment_received",       "condition": "amount >= total_outstanding + legal_costs" }
      ]
    },
    "timing_rules": {
      "grace_period_days": 5,
      "arrears_threshold_months": 1.0,
      "recovery_threshold_days": 60,
      "payment_plan_breach_threshold": 2,
      "uk_section_8_notice_days": 14,
      "dubai_ejari_notice_days": 30
    },
    "ladder_redirection_rules": {
      "rule": "Ladder contribution applied to arrears BEFORE equity purchase. This is a hard rule, not discretionary.",
      "application_order": [
        "apply_ladder_contribution_to_oldest_arrears_first",
        "any_remainder_purchases_equity_per_ladder_plan",
        "if_arrears_exceed_contribution_no_equity_purchased"
      ],
      "forced_liquidation": false,
      "forced_liquidation_note": "Existing ladder balance is protected. No forced liquidation of accrued equity unless explicitly contracted and disclosed to consumer."
    },
    "distribution_impact": {
      "loss_waterfall_priority": [
        "operator_fee_absorption",
        "platform_fee_absorption",
        "reserve_fund_drawdown",
        "investor_pro_rata_reduction"
      ],
      "reserve_fund_minimum_coverage_months": 3,
      "distribution_smoothing": "Reserve fund used to maintain investor distributions during temporary shortfall. If reserve < minimum coverage, governance notification triggered."
    }
  }
}
