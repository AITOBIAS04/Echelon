          "to": "CURRENT",
          "trigger": "balance_cleared"
        },
        {
          "condition": "outstanding >= arrears_threshold",
          "from": "PARTIAL_RECEIVED",
          "to": "ARREARS",
          "trigger": "arrears_threshold_crossed"
        },
        {
          "condition": "ladder_plan_active",
          "from": "ARREARS",
